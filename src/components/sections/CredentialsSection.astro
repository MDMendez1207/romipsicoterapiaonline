---
// Credentials Section — full academic formation
import '../../styles/credentials.css';
---
<section class="credentials section" aria-label="Formación académica">
  <div class="container">
    <div class="cred-header" data-reveal>
      <span class="section-label cred-section-label" id="cred-label">Formación</span>
    </div>

    <div class="cred-inner">
      <div class="cred-title-col" data-reveal="left" data-delay="100">
        <h2 class="text-headline cred-title" id="cred-title">Mi camino profesional</h2>
        <p class="cred-subtitle text-body" id="cred-subtitle">
          Formación rigurosa y especialización internacional para ofrecerte un apoyo clínico de alta calidad.
        </p>
      </div>

      <div class="cred-list-col">
        <ul class="cred-list" id="cred-list" aria-label="Títulos y formación">
          <!-- Populated by JS -->
        </ul>
      </div>
    </div>
  </div>
</section>



<script>
  import { getLang, t } from '../../i18n/index';
  import type { Lang } from '../../i18n/index';

  const renderList = (credentials: string[]) => {
    const list = document.getElementById('cred-list');
    if (!list) return;
    list.innerHTML = credentials.map((cred, i) => {
      const parts       = cred.split('|');
      const title       = parts[0]?.trim() ?? cred;
      const institution = parts[1]?.trim() ?? '';
      return `
        <li class="cred-item" style="transition-delay: ${i * 80}ms" data-cred-item>
          <div class="cred-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 -2 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M13 3L6 10l-3-3"/>
            </svg>
          <span class="cred-text">
            <strong>${title}</strong>${institution ? `  <strong>|</strong> <span>${institution}</span>` : ''}
          </span>
          </div>
          
        </li>
      `;
    }).join('');

    const items = list.querySelectorAll('[data-cred-item]');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    items.forEach(item => obs.observe(item));
  };

  const updateCredentials = (lang: Lang) => {
    const tr       = t(lang);
    const label    = document.getElementById('cred-label');
    const title    = document.getElementById('cred-title');
    const subtitle = document.getElementById('cred-subtitle');
    if (label)    label.textContent    = lang === 'es' ? 'Formación' : lang === 'en' ? 'Education' : 'Formazione';
    if (title)    title.textContent    = tr.about.credentials_title;
    if (subtitle) subtitle.textContent = tr.about.credentials_subtitle;
    renderList(tr.about.credentials);
  };

  updateCredentials(getLang());
  window.addEventListener('langchange', (e) => updateCredentials((e as CustomEvent).detail));
</script>
