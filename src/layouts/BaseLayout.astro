---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Romina Méndez · Psicoterapia Online · Migración y Duelos',
  description = 'Psicoterapeuta con más de 10 años de experiencia. Acompañamiento en migración, duelos y bienestar emocional. Sesiones online en español, inglés e italiano.',
} = Astro.props;
---
<!doctype html>
<html lang="es" id="html-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F8F6F2" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="psicoterapia online, psicóloga online, terapia migración, duelo migratorio, terapia en español, salud mental inmigrantes, ACT terapia, psicóloga argentina, terapia individual, terapia de pareja online, online psychotherapy, online psychologist, migration therapy, grief therapy, therapy in English, mental health immigrants, ACT therapy, expat therapy, individual therapy, couples therapy online, psicoterapia online, psicologa online, terapia migrazione, terapia del lutto, terapia in italiano, salute mentale immigrati, terapia per expat, terapia individuale, terapia di coppia online" />
    <meta name="author" content="Romina Méndez" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="sPALgcvDpFDzT3uxD2uzZE6QrQM7TsoCO1EdnxlBuT4" />

    <!-- hreflang for multilingual SEO -->
    <link rel="alternate" hreflang="es" href="https://rominamenendez.com/" />
    <link rel="alternate" hreflang="en" href="https://rominamenendez.com/" />
    <link rel="alternate" hreflang="it" href="https://rominamenendez.com/" />
    <link rel="alternate" hreflang="x-default" href="https://rominamenendez.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="it_IT" />
    <meta property="og:url" content="https://rominamenendez.com/" />
    <meta property="og:site_name" content="Romina Méndez Psicoterapia" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Romina Méndez · Psicoterapia Online",
        "description": "Psicoterapeuta especializada en migración y duelos. Sesiones online en español, inglés e italiano.",
        "url": "https://rominamenendez.com",
        "telephone": "+5491126629328",
        "availableLanguage": ["Spanish", "English", "Italian"],
        "serviceType": "Psychotherapy",
        "areaServed": "Online",
        "inLanguage": ["es", "en", "it"]
      }
    </script>



    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />

    <!-- Reveal on scroll -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('[data-reveal]').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
