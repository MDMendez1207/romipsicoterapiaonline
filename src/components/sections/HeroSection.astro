---
// Hero Section — fully i18n via client-side JS
import '../../styles/hero.css';
---
<section id="home" class="hero section" aria-label="Introducción">
  <!-- Background image subtle -->
  <div class="hero-bg" aria-hidden="true">
    <img src="/hero-bg.png" alt="" loading="eager" decoding="async" />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="container hero-inner">
    <!-- Text Content -->
    <div class="hero-content">
      <div data-reveal>
        <span class="section-label" id="hero-label">Psicoterapia Online</span>
      </div>

      <h1 class="hero-headline text-display" data-reveal data-delay="100">
        <em id="hero-headline-text">Ante una pérdida o una migración, el mundo parece más frío y hostil.</em>
      </h1>

      <p class="hero-subheadline text-body-lg" data-reveal data-delay="200" id="hero-subheadline">
        Apoyo emocional y psicológico para acompañarte en la recuperación de la calma y la resiliencia.
      </p>

      <p class="hero-intro text-body" data-reveal data-delay="300" id="hero-intro">
        Soy Romina Méndez, psicoterapeuta con más de 10 años de experiencia clínica. Brindo psicoterapia en tu idioma: español, inglés o italiano.
      </p>

      <div class="hero-actions" data-reveal data-delay="400">
        <a
          href="https://wa.me/5491126629328"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          id="hero-cta"
          aria-label="Contactar por WhatsApp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span id="hero-cta-text">Contactar</span>
        </a>

        <!-- Languages pill -->
        <div class="hero-langs" data-reveal data-delay="500">
          <span class="lang-pill">🇦🇷 ES</span>
          <span class="lang-pill">🇬🇧 EN</span>
          <span class="lang-pill">🇮🇹 IT</span>
        </div>
      </div>
    </div>

    <!-- Profile Image -->
    <div class="hero-image" data-reveal="right" data-delay="200">
      <div class="hero-image-frame">
        <img
          src="/profile-picture.png"
          alt="Romina Méndez — Psicoterapeuta"
          loading="eager"
          decoding="async"
          class="hero-photo"
          width="480"
          height="640"
        />
      </div>
      <div class="hero-badge" data-reveal data-delay="500">
        <span class="badge-years">10+</span>
        <span class="badge-text" id="hero-badge-text">años de<br>experiencia</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>



<script>
  import { getLang, t } from '../../i18n/index';
  import type { Lang } from '../../i18n/index';

  const updateHero = (lang: Lang) => {
    const tr = t(lang);
    const ids: Record<string, string> = {
      'hero-headline-text': tr.hero.headline,
      'hero-subheadline':   tr.hero.subheadline,
      'hero-intro':         tr.hero.intro,
      'hero-cta-text':      tr.hero.cta,
      'hero-badge-text':    lang === 'es' ? 'años de<br>experiencia'
                            : lang === 'en' ? 'years of<br>experience'
                            : 'anni di<br>esperienza',
    };
    Object.entries(ids).forEach(([id, value]) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = value;
    });
    const cta = document.getElementById('hero-cta');
    if (cta) cta.setAttribute('aria-label', tr.hero.cta_aria);
  };

  updateHero(getLang());
  window.addEventListener('langchange', (e) => updateHero((e as CustomEvent).detail));
</script>
